@model Inventory_Management_System_with_Sales_Management_MVC.Models.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Inventory Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --primary-color: #D6336C;
            --primary-hover: #c2185b;
            --bg-color: #EBEBEB;
            --text-color: #333;
            --input-border: #ddd;
            --white: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            background: var(--white);
            border-radius: 24px;
            box-shadow: 0 14px 28px rgba(0,0,0,0.05), 0 10px 10px rgba(0,0,0,0.02);
            width: 100%;
            max-width: 500px;
            padding: 50px 40px;
            text-align: center;
        }

        .icon-wrapper {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #D6336C 0%, #a01c4b 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
        }

            .icon-wrapper i {
                font-size: 48px;
                color: white;
            }

        h1 {
            font-weight: 700;
            margin-bottom: 15px;
            color: #000;
            font-size: 32px;
        }

        .subtitle {
            color: #666;
            font-size: 15px;
            margin-bottom: 35px;
            line-height: 1.6;
        }

        .form-group {
            text-align: left;
            margin-bottom: 20px;
        }

        label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #444;
            display: block;
        }

        input {
            background-color: var(--white);
            border: 1px solid var(--input-border);
            border-radius: 12px;
            padding: 14px 15px;
            width: 100%;
            font-size: 14px;
            outline: none;
            transition: 0.3s;
            color: #555;
        }

            input:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(214, 51, 108, 0.1);
            }

        .btn-primary {
            border-radius: 50px;
            border: none;
            background-color: var(--primary-color);
            color: #FFFFFF;
            font-size: 14px;
            font-weight: 600;
            padding: 14px 45px;
            transition: transform 80ms ease-in, background-color 0.3s;
            cursor: pointer;
            margin-top: 10px;
            width: 100%;
            box-shadow: 0 4px 15px rgba(214, 51, 108, 0.3);
        }

            .btn-primary:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
            }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            margin-top: 25px;
            transition: 0.3s;
        }

            .back-link:hover {
                gap: 12px;
            }

        .validation-message {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="icon-wrapper">
            <i class="fas fa-key"></i>
        </div>

        <h1>Forgot Password?</h1>
        <p class="subtitle">No worries! Enter your email address and we'll send you a verification code to reset your password.</p>

        <form asp-action="ForgotPassword" method="post">
            <div class="form-group">
                <label>Email Address</label>
                <input asp-for="Email" type="email" placeholder="Enter your registered email" required />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <button type="submit" class="btn-primary">
                <i class="fas fa-paper-plane" style="margin-right: 8px;"></i>
                Send Verification Code
            </button>
        </form>

        <a asp-action="Login" asp-controller="Login" method="post">
            <i class="fas fa-arrow-left"></i>
            Back to Login
        </a>

    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>